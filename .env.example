# Copy to .env and fill in. .env is gitignored; never commit real keys.
# NOT required for the default demo, which runs on SQLite with no config.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct Postgres connection used by SupabaseRepository
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Pipeline configuration
BRAHMO_ORG_ID=supra
BRAHMO_DERIVABILITY_THRESHOLD=0.7
BRAHMO_PERMISSION_MODE=strict
