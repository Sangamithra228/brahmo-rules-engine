# Copy to .env and fill in. .env is gitignored - never commit real credentials.
# ---------------------------------------------------------------------------

# Which database the application uses.
#   supabase  (default) - PostgreSQL, the primary backend
#   sqlite              - local offline fallback, for development and tests
# If this is unset the app uses Supabase and refuses to start when Supabase is
# not configured. It will not fall back silently.
DATABASE_BACKEND=supabase

# Supabase -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional. Only needed if you script schema/seed loading; not used at runtime.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- API security -----------------------------------------------------------
# The /admin routes expose the exclusion trail (the ids and titles of nodes a
# user was NOT given). Leave unset for local demos and they serve loopback
# clients only. Set this for ANY non-local deployment: an X-Admin-Token header
# then becomes mandatory from every host, including localhost.
# BRAHMO_ADMIN_TOKEN=generate-a-long-random-value

# Comma-separated origins allowed by CORS. Never use "*": a wildcard would let
# any website read the audit trail out of a logged-in browser.
# BRAHMO_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Pipeline configuration
BRAHMO_ORG_ID=supra
BRAHMO_DERIVABILITY_THRESHOLD=0.7
BRAHMO_PERMISSION_MODE=strict

# Only used when DATABASE_BACKEND=sqlite
# SQLITE_PATH=backend/data/brahmo.db
